{
  "name": "@razcrypto/checkout",
  "version": "1.0.1",
  "description": "RazCrypto Gateway browser checkout (checkout.js): opens hosted crypto checkout in a modal. Publishable key only.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/checkout.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/checkout.esm.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": true,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["razcrypto", "crypto", "payments", "checkout"],
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
